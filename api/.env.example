NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fusion:fusion@localhost:5432/fusion?schema=public
REDIS_URL=redis://localhost:6379
# Number of reverse proxies in front of the API (0 = none). Set it when
# deployed behind one, or every client shares a single rate limit.
TRUST_PROXY=0

# Sign in with Google. Create an OAuth client ID of type "Web application" in
# Google Cloud Console and add the frontend's origin (and http://localhost:4000
# for /demo) to its authorised JavaScript origins. Blank = nobody can sign in.
GOOGLE_CLIENT_ID=
# Who is a bank officer, comma separated. Every other account is a business owner.
AUTH_BANK_EMAILS=
AUTH_BANK_DOMAINS=
# false = every signed-in user gets bank access and the two lists above are
# ignored. Local development only: it is ignored when NODE_ENV=production.
AUTH_ROLES_ENFORCED=true
# Frontend origins allowed to call the API with the session cookie
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# lax, or none when the frontend is on a different site from the API (needs HTTPS)
AUTH_COOKIE_SAMESITE=lax

# Climate agent (OpenAI). Leave the key blank to run rule-based only.
OPENAI_API_KEY=
CLIMATE_AGENT_ENABLED=true
CLIMATE_AGENT_MODEL=gpt-5-nano

# Input service: weather-impact classifier (OpenAI). Needs OPENAI_API_KEY;
# without it every business gets its sector defaults.
INPUT_CLASSIFIER_ENABLED=true
# Must accept temperature 0; gpt-5 and o-series models run at low reasoning effort instead
INPUT_CLASSIFIER_MODEL=gpt-4.1-mini
# Read by POST /seed/smes (not available in production)
INPUT_SEED_FILE=data/smes.json

# Finance service. rules scores with the built-in rules; ml sends the metrics
# to FINANCE_ML_URL (the Python model, not built yet) and falls back to the rules
FINANCE_SCORER=rules
FINANCE_ML_URL=

# Alert system. dry_run logs messages and stores them without calling a provider.
ALERTS_ENABLED=true
ALERTS_MODE=dry_run
ALERTS_POLL_SECONDS=15
ALERTS_COOLDOWN_HOURS=6
ALERTS_TZ=Asia/Kolkata
# Local time the bank's daily WATCH digest is sent
ALERTS_DIGEST_TIME=09:00
# Base URL of the dashboard, used for the borrower link in bank emails
ALERTS_DASHBOARD_URL=http://localhost:3000

# Email (live mode only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERTS_FROM_EMAIL=

# Background monitor (npm run monitor). A separate process from the API.
MONITOR_ENABLED=true
MONITOR_TICK_MINUTES=15
MONITOR_CONCURRENCY=5
# Optional agent review of each cell, at most every 6 hours. Needs OPENAI_API_KEY.
MONITOR_AGENT_ENABLED=false
# Watched locations, until the loans DB exists
MONITOR_LOCATIONS_FILE=data/monitor-locations.json
# outbox hands alerts to the alert system; console only prints them
MONITOR_ALERT_SINK=outbox
