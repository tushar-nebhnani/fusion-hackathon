NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fusion:fusion@localhost:5432/fusion?schema=public
REDIS_URL=redis://localhost:6379

# Climate agent (OpenAI). Leave the key blank to run rule-based only.
OPENAI_API_KEY=
CLIMATE_AGENT_ENABLED=true
CLIMATE_AGENT_MODEL=gpt-5-nano

# Alert system. dry_run logs messages and stores them without calling a provider.
ALERTS_ENABLED=true
ALERTS_MODE=dry_run
ALERTS_POLL_SECONDS=15
ALERTS_COOLDOWN_HOURS=6
ALERTS_TZ=Asia/Kolkata
# Local time the bank's daily WATCH digest is sent
ALERTS_DIGEST_TIME=09:00
# Base URL of the dashboard, used for the borrower link in bank emails
ALERTS_DASHBOARD_URL=http://localhost:3000

# Email (live mode only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERTS_FROM_EMAIL=

# Chat advisor. Blank key: falls back to OPENAI_API_KEY, then to the offline planner.
ADVISOR_LLM_PROVIDER=
ADVISOR_LLM_MODEL=gpt-5-mini
ADVISOR_LLM_API_KEY=
ADVISOR_MAX_ITERATIONS=8
ADVISOR_ENABLE_DEV_ROUTES=true
