generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Relevance {
  primary
  secondary
  dormant
}

enum RelevanceMethod {
  static
  agent_raised
}

enum Confidence {
  low
  med
  high
}

enum MetricKind {
  observed
  forecast
  projection
}

enum ResponseStatus {
  fresh
  stale
  error
}

enum EventSeverity {
  watch
  warning
  severe
}

enum EventStatus {
  open
  escalated
  closed
}

enum CacheResult {
  complete_hit
  partial_hit
  miss
}

model HazardCatalog {
  hazard             String @id
  apis               Json
  screeningVariables Json   @map("screening_variables")
  currentVariables   Json   @map("current_variables")
  indicatorRule      Json   @map("indicator_rule")
  primaryThreshold   Float  @map("primary_threshold")
  dormantThreshold   Float  @map("dormant_threshold")
  tripwireVariables  Json   @map("tripwire_variables")

  relevance CellHazardRelevance[]
  scores    HazardScore[]
  events    CellEvent[]

  @@map("hazard_catalog")
}

// One row per snapped cell. Sources that share a resolution (historical,
// climate, forecast at 0.1 deg) share the same cell id, so there is no
// `source` column; the layer is identified by `climate_responses.api`.
model GridCell {
  id            String @id
  resolutionDeg Float  @map("resolution_deg")
  latCenter     Float  @map("lat_center")
  lonCenter     Float  @map("lon_center")

  relevance CellHazardRelevance[]
  responses ClimateResponse[]
  metrics   ClimateMetric[]
  events    CellEvent[]

  pointsHistorical Point[] @relation("PointHistoricalCell")
  pointsClimate    Point[] @relation("PointClimateCell")
  pointsFlood      Point[] @relation("PointFloodCell")
  pointsForecast   Point[] @relation("PointForecastCell")

  @@map("grid_cells")
}

model Point {
  id             Int      @id @default(autoincrement())
  lat            Float
  lon            Float
  cellHistorical String   @map("cell_historical")
  cellClimate    String   @map("cell_climate")
  cellFlood      String   @map("cell_flood")
  cellForecast   String   @map("cell_forecast")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  historicalCell GridCell @relation("PointHistoricalCell", fields: [cellHistorical], references: [id])
  climateCell    GridCell @relation("PointClimateCell", fields: [cellClimate], references: [id])
  floodCell      GridCell @relation("PointFloodCell", fields: [cellFlood], references: [id])
  forecastCell   GridCell @relation("PointForecastCell", fields: [cellForecast], references: [id])

  staticFeatures PointStaticFeatures?
  scores         HazardScore[]
  requests       RequestLog[]

  @@unique([lat, lon])
  @@index([cellFlood])
  @@index([cellForecast])
  @@map("points")
}

model PointStaticFeatures {
  pointId            Int      @id @map("point_id")
  elevationM         Float?   @map("elevation_m")
  relativeElevationM Float?   @map("relative_elevation_m")
  floodExposureShare Float?   @map("flood_exposure_share")
  sourceVersion      String   @map("source_version")
  computedAt         DateTime @map("computed_at") @db.Timestamptz

  point Point @relation(fields: [pointId], references: [id])

  @@map("point_static_features")
}

model CellHazardRelevance {
  cellId         String          @map("cell_id")
  hazard         String
  relevance      Relevance
  indicatorValue Float?          @map("indicator_value")
  indicators     Json
  method         RelevanceMethod @default(static)
  rationale      String?
  evidenceUrls   Json?           @map("evidence_urls")
  confidence     Confidence
  decidedAt      DateTime        @map("decided_at") @db.Timestamptz
  reviewAfter    DateTime        @map("review_after") @db.Timestamptz
  ruleVersion    String          @map("rule_version")
  agentVersion   String?         @map("agent_version")

  cell    GridCell      @relation(fields: [cellId], references: [id])
  catalog HazardCatalog @relation(fields: [hazard], references: [hazard])

  @@id([cellId, hazard])
  @@map("cell_hazard_relevance")
}

// Raw upstream payloads. This table is the cache.
model ClimateResponse {
  id                 Int            @id @default(autoincrement())
  cellId             String         @map("cell_id")
  api                String
  variablesRequested Json           @map("variables_requested")
  paramsHash         String         @map("params_hash")
  response           Json
  fetchedAt          DateTime       @map("fetched_at") @db.Timestamptz
  staleAfter         DateTime?      @map("stale_after") @db.Timestamptz
  status             ResponseStatus @default(fresh)

  cell    GridCell        @relation(fields: [cellId], references: [id])
  metrics ClimateMetric[]
  events  CellEvent[]

  @@unique([cellId, api, paramsHash])
  @@index([cellId, api, staleAfter])
  @@map("climate_responses")
}

// Normalized, long format. Observed and projection rows use the epoch as
// `issued_at` so re-fetching history never duplicates a day.
model ClimateMetric {
  cellId     String     @map("cell_id")
  date       DateTime   @db.Date
  variable   String
  value      Float
  kind       MetricKind
  issuedAt   DateTime   @map("issued_at") @db.Timestamptz
  responseId Int?       @map("response_id")

  cell     GridCell         @relation(fields: [cellId], references: [id])
  response ClimateResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@id([cellId, date, variable, kind, issuedAt])
  @@index([cellId, variable, date])
  @@map("climate_metrics")
}

model HazardScore {
  id           Int       @id @default(autoincrement())
  pointId      Int       @map("point_id")
  hazard       String
  relevance    Relevance
  structural   Float?
  historical   Float
  forecast     Float
  score        Float
  computedAt   DateTime  @map("computed_at") @db.Timestamptz
  modelVersion String    @map("model_version")

  point   Point         @relation(fields: [pointId], references: [id])
  catalog HazardCatalog @relation(fields: [hazard], references: [hazard])

  @@index([pointId, computedAt])
  @@map("hazard_scores")
}

model CellEvent {
  id               Int           @id @default(autoincrement())
  cellId           String        @map("cell_id")
  hazard           String
  severity         EventSeverity
  windowStart      DateTime      @map("window_start") @db.Date
  windowEnd        DateTime      @map("window_end") @db.Date
  confidence       Float
  sourceResponseId Int?          @map("source_response_id")
  status           EventStatus   @default(open)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  cell           GridCell         @relation(fields: [cellId], references: [id])
  catalog        HazardCatalog    @relation(fields: [hazard], references: [hazard])
  sourceResponse ClimateResponse? @relation(fields: [sourceResponseId], references: [id], onDelete: SetNull)

  @@index([status, windowStart])
  @@index([cellId, hazard, status])
  @@map("cell_events")
}

model RequestLog {
  id          Int         @id @default(autoincrement())
  requesterId String?     @map("requester_id")
  pointId     Int         @map("point_id")
  cacheResult CacheResult @map("cache_result")
  latencyMs   Int         @map("latency_ms")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  point Point @relation(fields: [pointId], references: [id])

  @@index([pointId, createdAt])
  @@map("request_log")
}

// Idempotency-Key records. A row with no response is a request in flight;
// `expires_at` is the lock timeout until the response is stored, then its TTL.
model IdempotencyKey {
  scope          String
  key            String
  fingerprint    String
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum AlertAudience {
  owner
  bank
}

enum AlertChannel {
  email
  sms
}

enum AlertSeverity {
  WATCH
  WARNING
  CRITICAL
}

enum AlertStatus {
  pending
  sending
  sent
  failed
  dead
  suppressed
}

// Name, city and sector that alert messages show for a business. Owned by
// the alert system until a real business table exists.
model AlertBusiness {
  id     String  @id
  name   String
  city   String
  sector String?

  @@map("alert_businesses")
}

// What needs to be sent. Producers only insert here; the alert worker claims
// rows with `claimed_by` + `lease_until` and does the sending.
model AlertOutbox {
  id         Int           @id @default(autoincrement())
  dedupeKey  String        @map("dedupe_key")
  businessId String        @map("business_id")
  audience   AlertAudience
  channel    AlertChannel
  hazard     String
  severity   AlertSeverity
  payload    Json          @map("payload_json")
  status     AlertStatus   @default(pending)
  attempts   Int           @default(0)
  nextTryAt  DateTime      @map("next_try_at") @db.Timestamptz
  claimedBy  String?       @map("claimed_by")
  leaseUntil DateTime?     @map("lease_until") @db.Timestamptz
  lastError  String?       @map("last_error")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  deliveries AlertDelivery[]

  @@unique([dedupeKey, audience, channel])
  @@index([status, nextTryAt])
  @@index([businessId, hazard, audience, channel])
  @@map("alert_outbox")
}

// Every send attempt, for the dashboard and audit. `subject` and `body` are
// the message as rendered, so the dashboard can preview it.
model AlertDelivery {
  id          Int      @id @default(autoincrement())
  outboxId    Int      @map("outbox_id")
  provider    String
  providerRef String?  @map("provider_ref")
  result      String
  error       String?
  subject     String?
  body        String?
  sentAt      DateTime @map("sent_at") @db.Timestamptz

  outbox AlertOutbox @relation(fields: [outboxId], references: [id])

  @@index([outboxId])
  @@index([sentAt])
  @@map("alert_deliveries")
}

// Who can be contacted, and whether they agreed. No `consent_at` means no
// message, ever. Bank users have no `business_id`.
model AlertContact {
  id         Int           @id @default(autoincrement())
  businessId String?       @map("business_id")
  audience   AlertAudience
  name       String?
  email      String?
  phoneE164  String?       @map("phone_e164")
  language   String        @default("en")
  consentAt  DateTime?     @map("consent_at") @db.Timestamptz
  optedOutAt DateTime?     @map("opted_out_at") @db.Timestamptz

  @@index([audience, businessId])
  @@map("alert_contacts")
}

// --- Background monitor (src/services/climate/monitor) ---

enum MonitorLevel {
  NORMAL
  WATCH
  WARNING
  SEVERE
}

enum DisasterEventStatus {
  pending
  hit
  false_alarm
  missed
}

// One row per watched forecast cell. `cell_id` is the id the forecast cache
// uses, so a monitor cell and a cache cell are the same thing. The schedule
// lives here, not in timers, which is what makes the monitor restart-safe.
model MonitoredCell {
  cellId            String       @id @map("cell_id")
  // The location the cell is checked at: one of the businesses inside it
  lat               Float
  lon               Float
  active            Boolean      @default(true)
  level             MonitorLevel @default(NORMAL)
  calmRuns          Int          @default(0) @map("calm_runs")
  nextCheckAt       DateTime     @map("next_check_at") @db.Timestamptz
  lastCheckedAt     DateTime?    @map("last_checked_at") @db.Timestamptz
  // Per-hazard levels and key forecast values of the last check
  lastSnapshot      Json?        @map("last_snapshot")
  lastAgentReviewAt DateTime?    @map("last_agent_review_at") @db.Timestamptz
  // Lease held by the monitor instance checking the cell
  lockedBy          String?      @map("locked_by")
  lockUntil         DateTime?    @map("lock_until") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([active, nextCheckAt])
  @@map("monitored_cells")
}

// One row per sudden change the monitor detected, labelled later against
// observed data. Training data for the ML model.
model DisasterEvent {
  eventId        Int                 @id @default(autoincrement()) @map("event_id")
  cellId         String              @map("cell_id")
  hazard         String
  level          MonitorLevel
  windowStart    DateTime            @map("window_start") @db.Date
  windowEnd      DateTime            @map("window_end") @db.Date
  forecastValues Json                @map("forecast_values")
  evidence       String
  status         DisasterEventStatus @default(pending)
  observedValues Json?               @map("observed_values")
  // Monitor run that raised it; null for `missed` events
  sourceRunId    String?             @map("source_run_id")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  verifiedAt     DateTime?           @map("verified_at") @db.Timestamptz

  @@index([status, windowEnd])
  @@index([cellId, hazard, windowStart])
  @@map("disaster_events")
}

// ---- Input service (services/input) ----
// Enum-like columns are plain strings; the service's zod schemas own the
// allowed values, so adding one needs no migration.

// One business as entered through the form. The input groups are kept as
// the validated JSON the owner submitted; `name` and `sector` are copied
// out for lookups.
model Business {
  id          String   @id @default(uuid())
  // `user` or `synthetic` (seeded)
  source      String   @default("user")
  // Id of the seed entry, so a seed run can be repeated
  externalId  String?  @unique @map("external_id")
  // The signed-in user who created it. Null for seeded and bank-created
  // businesses, which only bank officers can open.
  ownerUserId String?  @map("owner_user_id")
  name        String
  sector      String
  profile     Json
  operations  Json
  contacts    Json
  consent     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner          User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  locations      BusinessLocation[]
  suppliers      BusinessSupplier[]
  snapshots      FinancialSnapshot[]
  loans          Loan[]
  impactProfiles WeatherImpactProfile[]
  triggerJobs    InputTriggerJob[]

  @@index([ownerUserId])
  @@map("businesses")
}

model BusinessLocation {
  id         Int     @id @default(autoincrement())
  businessId String  @map("business_id")
  isPrimary  Boolean @map("is_primary")
  position   Int
  lat        Float
  lon        Float
  address    String
  pincode    String?
  premises   String?
  floor      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, position])
  @@map("business_locations")
}

model BusinessSupplier {
  id         Int     @id @default(autoincrement())
  businessId String  @map("business_id")
  position   Int
  name       String
  lat        Float
  lon        Float
  share      Float
  critical   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, position])
  @@map("business_suppliers")
}

// Append only: a new submission is a new version, the values of an old one
// never change. `raw` is what was entered, `derived` the ratios computed
// from it by `derivation_version`.
model FinancialSnapshot {
  id                Int       @id @default(autoincrement())
  businessId        String    @map("business_id")
  version           Int
  asOf              DateTime  @map("as_of") @db.Date
  raw               Json
  derived           Json
  derivationVersion String    @map("derivation_version")
  verifiedByBank    Boolean   @default(false) @map("verified_by_bank")
  verifiedBy        String?   @map("verified_by")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, version])
  @@map("financial_snapshots")
}

model Loan {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  amount       Float
  emi          Float
  tenureMonths Int      @map("tenure_months")
  interestRate Float?   @map("interest_rate")
  purpose      String?
  // applied -> authorised -> active -> closed, or rejected
  status       String   @default("applied")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@map("loans")
}

// One row per classifier run or bank override. A `pending` row is a run
// that has not finished; it is filled in place when it does.
model WeatherImpactProfile {
  id                Int      @id @default(autoincrement())
  businessId        String   @map("business_id")
  version           Int
  // pending | ok | fallback | overridden
  status            String
  category          String?
  conditions        Json?
  overallConfidence Float?   @map("overall_confidence")
  model             String?
  promptVersion     String   @map("prompt_version")
  inputsHash        String   @map("inputs_hash")
  // The model's reply before the guardrails were applied
  rawOutput         Json?    @map("raw_output")
  note              String?
  overriddenBy      String?  @map("overridden_by")
  overrideReason    String?  @map("override_reason")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, version])
  // Classifier cache lookup
  @@index([inputsHash, promptVersion, model, status])
  @@map("weather_impact_profiles")
}

// Calls owed to the climate unit and the finance service after a save. A
// row stays `pending` until its call succeeds, so a failed or unconnected
// service never loses a trigger.
model InputTriggerJob {
  id         Int      @id @default(autoincrement())
  businessId String   @map("business_id")
  // climate_warm | finance_first_profile | finance_recompute
  kind       String
  payload    Json
  // pending | done
  status     String   @default("pending")
  attempts   Int      @default(0)
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([businessId, status])
  @@map("input_trigger_jobs")
}

model InputRequestLog {
  id         Int      @id @default(autoincrement())
  method     String
  route      String
  status     Int
  latencyMs  Int      @map("latency_ms")
  businessId String?  @map("business_id")
  actorRole  String?  @map("actor_role")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("input_request_log")
}

// ---- Authentication (Sign in with Google) ----

// One row per Google account that has signed in. The role is not stored: it
// is worked out from the email and the AUTH_BANK_* settings on every request.
model User {
  id          String   @id @default(uuid())
  // Google's stable account id (the `sub` claim)
  googleSub   String   @unique @map("google_sub")
  email       String
  name        String?
  pictureUrl  String?  @map("picture_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt DateTime @default(now()) @map("last_login_at") @db.Timestamptz

  sessions   Session[]
  businesses Business[]

  @@map("users")
}

// A signed-in browser. Only the SHA-256 of the cookie value is stored.
model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
